{
  "version": 2,
  "builds": [
    {
      "src": "api/health.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/analyze.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_login.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_employees.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_pension.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_settlement.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_payroll.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_other_payments.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_backup.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/hr_storage_backup.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/workspace.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "api/monthly_closing.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "api/health.py" },
    { "src": "/api/analyze", "dest": "api/analyze.py" },
    { "src": "/api/hr_login", "dest": "api/hr_login.py" },
    { "src": "/api/hr_employees", "dest": "api/hr_employees.py" },
    { "src": "/api/hr_pension", "dest": "api/hr_pension.py" },
    { "src": "/api/hr_settlement", "dest": "api/hr_settlement.py" },
    { "src": "/api/hr_payroll", "dest": "api/hr_payroll.py" },
    { "src": "/api/hr_other_payments", "dest": "api/hr_other_payments.py" },
    { "src": "/api/hr_backup", "dest": "api/hr_backup.py" },
    { "src": "/api/hr_storage_backup", "dest": "api/hr_storage_backup.py" },
    { "src": "/api/schedule", "dest": "api/workspace.py?resource=schedule" },
    { "src": "/api/contacts", "dest": "api/workspace.py?resource=contacts" },
    { "src": "/api/contract_docs", "dest": "api/workspace.py?resource=contractdocs" },
    { "src": "/api/daily_todos", "dest": "api/workspace.py?resource=todos" },
    { "src": "/api/promotions", "dest": "api/workspace.py?resource=promotions" },
    { "src": "/api/annual_leave_calc", "dest": "api/workspace.py?resource=annualleave" },
    { "src": "/api/personal_schedule", "dest": "api/workspace.py?resource=personal" },
    { "src": "/api/family_notes", "dest": "api/workspace.py?resource=family_notes" },
    { "src": "/api/timetable", "dest": "api/workspace.py?resource=timetable" },
    { "src": "/api/manuals", "dest": "api/workspace.py?resource=manuals" },
    { "src": "/api/monthly_closing", "dest": "api/monthly_closing.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
